// Prisma schema for Memory Arena

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Player {
  id          String   @id @default(cuid())
  lineUserId  String   @unique
  displayName String
  pictureUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matchPlayers MatchPlayer[]
  wonMatches   Match[]       @relation("MatchWinner")

  @@index([lineUserId])
}

model GameSession {
  id              String   @id @default(cuid())
  status          String   @default("WAITING")
  difficulty      String   @default("MEDIUM")
  player1Id       String?
  player2Id       String?
  currentRound    Int      @default(1)
  player1Score    Int      @default(0)
  player2Score    Int      @default(0)
  currentSequence Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model Match {
  id           String   @id @default(cuid())
  difficulty   String   @default("MEDIUM")
  winnerId     String?
  durationMs   Int      @default(0)
  player1Score Int      @default(0)
  player2Score Int      @default(0)
  startedAt    DateTime @default(now())
  finishedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  winner       Player?       @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  rounds       Round[]
  matchPlayers MatchPlayer[]

  @@index([winnerId])
  @@index([createdAt])
  @@index([difficulty])
}

model Round {
  id                 String   @id @default(cuid())
  matchId            String
  roundNumber        Int
  sequence           Json
  player1Input       Json
  player2Input       Json
  player1Time        Int
  player2Time        Int
  winnerPlayerNumber Int?
  player1Correct     Boolean  @default(false)
  player2Correct     Boolean  @default(false)
  createdAt          DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([roundNumber])
}

model MatchPlayer {
  id           String   @id @default(cuid())
  matchId      String
  playerId     String
  playerNumber Int
  createdAt    DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([matchId, playerNumber])
  @@index([matchId])
  @@index([playerId])
}
